# frontier-palm-usd Environment Variables
# Copy to .env.local and fill in values

NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Gold API Key (Required for fetching live gold reserve metrics)
# 1. Go to https://www.goldapi.io/
# 2. Sign up for a free account
# 3. Log in to your dashboard to get your API key
# 4. Copy and paste it here
GOLD_API_KEY=

# Palm USD Documentation (No API key required)
# For more info on Palm USD integration, see:
# https://www.palmusd.com/pages/developers.html
